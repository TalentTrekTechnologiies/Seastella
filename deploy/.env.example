# Copy to deploy/.env on the VPS and fill in. Never commit the real file.

# --- Database (created by docker compose on first start) --------------------
DB_USERNAME=thawemarine
# openssl rand -base64 24
DB_PASSWORD=change-me-long-random

# --- Security -----------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes

# --- Where people open the app. Email links point here. -----------------------
APP_BASE_URL=https://thaweone.com

# --- The first Platform Admin ---------------------------------------------------
# Created on first start only, while no Platform Admin exists. 12+ characters,
# not containing the email name. Remove the password line once you have signed in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Platform Administrator

# --- Email (optional). Without these, deliveries are recorded as SKIPPED. ------
# seastella.in mail is on Zoho: uncomment and fill in with a mailbox on the
# domain and a Zoho app password. MAIL_FROM must be that same mailbox.
#SPRING_MAIL_HOST=smtp.zoho.in
#SPRING_MAIL_PORT=587
#SPRING_MAIL_USERNAME=no-reply@seastella.in
#SPRING_MAIL_PASSWORD=
MAIL_FROM=Thawe Marine <no-reply@seastella.in>
MAIL_REPLY_TO=team@seastella.in

# --- Local port the backend listens on (loopback only) ------------------------
# deploy.sh points nginx at it. Must be free: the VPS runs other sites, and
# 8080 is often taken by another Java app.
BACKEND_PORT=8085
